# Copy this file to .env and fill in your real values.
# Get BOT_TOKEN from @BotFather on Telegram (/newbot).
# Get GROQ_API_KEY from https://console.groq.com (API Keys).

BOT_TOKEN=your-telegram-bot-token-here
GROQ_API_KEY=your-groq-api-key-here
# Optional backup Groq keys (comma-separated). Used automatically, in order,
# when the primary key runs out of tokens / hits its rate limit.
GROQ_BACKUP_KEYS=

# --- Models (see https://console.groq.com/docs/models) --------------------
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Multimodal model used to read forwarded screenshots:
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Generation defaults (users override per-chat via /settings) ----------
DEFAULT_PERSONA=random          # random or a persona key (sigma, skibidi, rizzler, …)
DEFAULT_INTENSITY=medium        # mild | medium | unhinged  (how feral the chaos is)
DEFAULT_LENGTH=short            # short | medium | long | max  (output length; short = 1-2 sentences)
DEFAULT_TONE=default            # default | roast | cope | hype | deny | gaslight
DEFAULT_LANGUAGE=auto           # auto = match the convo, or Uzbek/English/Russian/…
DEFAULT_CANDIDATES=1            # best-of-N (1 = single reply)
MAX_CANDIDATES=3
GROUP_HISTORY_SIZE=15           # recent msgs buffered per group for @mention auto-replies
                                # (requires privacy mode OFF in BotFather to see them)
STREAMING=false                 # stream tokens into the message instead of the cooking animation

# --- Live trends (auto-refresh the brainrot vocab) ------------------------
# A daily job pulls hot titles from these subreddits and an LLM extracts current
# slang; the owner curates with /trend add|ban|remove. Best-effort — safe to leave on.
TREND_FETCH_ENABLED=true
TREND_SUBREDDITS=brainrot,GenZ,teenagers,tiktokcringe
TREND_FETCH_HOUR=5              # server-local hour for the daily auto-fetch
TREND_MAX_ADD=25               # max new terms stored per refresh
MAX_TRANSCRIPT_CHARS=6000       # token-budget guard on long forwards

# --- Rate limits (public bot protection) ----------------------------------
RL_COOLDOWN_S=8
RL_PER_USER_PER_MIN=15
RL_GLOBAL_PER_MIN=80

# --- Access control -------------------------------------------------------
# Comma-separated Telegram user IDs. Required for /stats. If PRIVATE_MODE=true,
# only these users can generate.
OWNER_IDS=
PRIVATE_MODE=false

# --- Persistence ----------------------------------------------------------
DB_PATH=brainrot.db

# --- Daily brainrot -------------------------------------------------------
DAILY_DEFAULT_HOUR=9            # server-local hour for /daily posts

# --- Ops: health check, webhook, logging ----------------------------------
HEALTH_PORT=0                  # >0 enables GET /healthz on that port
SINGLE_INSTANCE_LOCK=true       # refuse to start a 2nd polling instance (avoids getUpdates 409)
LOG_LEVEL=INFO
LOG_FILE=                       # path to also log to a file (empty = stderr only)
# Leave WEBHOOK_URL empty for long polling. To use webhooks (hosted deploy):
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_SECRET=
