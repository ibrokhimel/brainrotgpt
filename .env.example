# Copy this file to .env and fill in your real values.
# Get BOT_TOKEN from @BotFather on Telegram (/newbot).
# Get GROQ_API_KEY from https://console.groq.com (API Keys).

BOT_TOKEN=your-telegram-bot-token-here
GROQ_API_KEY=your-groq-api-key-here

# Optional: change the Groq model (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: rate limits (public bot protection)
RL_COOLDOWN_S=8
RL_PER_USER_PER_MIN=15
RL_GLOBAL_PER_MIN=80
