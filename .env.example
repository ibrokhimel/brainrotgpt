# Copy this file to .env and fill in your real values.
# Get BOT_TOKEN from @BotFather on Telegram (/newbot).
# Get GROQ_API_KEY from https://console.groq.com (API Keys).

BOT_TOKEN=your-telegram-bot-token-here
GROQ_API_KEY=your-groq-api-key-here
# Optional backup Groq keys (comma-separated). Used automatically, in order,
# when the primary key runs out of tokens / hits its rate limit.
GROQ_BACKUP_KEYS=

# --- Models (see https://console.groq.com/docs/models) --------------------
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Multimodal model used to read forwarded screenshots:
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Legacy generation knobs (brainrot.py / inline mode only) --------------
# v3 is one kid, not a style picker — /settings only has mood/chattiness/mute
# (see "The kid" below). brainrot.py still exists to power inline mode
# (@yourbot <text>), but on_inline() currently hard-codes its own persona/
# intensity/tone/language and does not read these. Kept for reference.
DEFAULT_PERSONA=random          # random or a persona key (sigma, skibidi, rizzler, …)
DEFAULT_LANGUAGE=auto           # auto = match the convo, or Uzbek/English/Russian/…
GROUP_HISTORY_SIZE=15           # not currently read by any code path
MAX_TRANSCRIPT_CHARS=6000       # token-budget guard on long forwards (guard.py)

# --- Live trends (auto-refresh the brainrot vocab) -------------------------
# A daily job pulls hot titles from these subreddits plus Know Your Meme, and an
# LLM extracts current slang/memes; the owner curates with /trend add|ban|remove.
# Best-effort — safe to leave on. Mixed into the kid's system prompt every reply.
TREND_FETCH_ENABLED=true
TREND_SUBREDDITS=OutOfTheLoop,brainrot,memes,dankmemes,GenZ,teenagers,tiktokcringe,InstagramReels
TREND_FETCH_HOUR=5              # server-local hour for the daily auto-fetch
TREND_MAX_ADD=25                # max new terms/memes stored per refresh
# Know Your Meme's popular page — curated meme names, not slang soup. Disable if
# you'd rather rely on the subreddit-only extraction.
KYM_FETCH_ENABLED=true

# --- Rate limits (public bot protection) ------------------------------------
RL_COOLDOWN_S=8
RL_PER_USER_PER_MIN=15
RL_GLOBAL_PER_MIN=80

# --- Access control ----------------------------------------------------------
# Comma-separated Telegram user IDs. Required for /stats and /trend. If
# PRIVATE_MODE=true, only these users get replies at all.
OWNER_IDS=
PRIVATE_MODE=false

# --- Persistence --------------------------------------------------------------
DB_PATH=brainrot.db

# --- Ops: health check, webhook, logging --------------------------------------
HEALTH_PORT=0                  # >0 enables GET /healthz on that port
SINGLE_INSTANCE_LOCK=true       # refuse to start a 2nd polling instance (avoids getUpdates 409)
LOG_LEVEL=INFO
LOG_FILE=                       # path to also log to a file (empty = stderr only)
# Leave WEBHOOK_URL empty for long polling. To use webhooks (hosted deploy):
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_SECRET=

# --- Outbound budget (protects the Groq quota) --------------------------------
# Ghost pings, cold opens, notes distillation and the daily life state are LLM
# calls nobody asked for, and they scale with chat count. This caps them per
# day, globally, across all chats. Replies to real users are NEVER budgeted —
# they come out of a separate, unbudgeted path. 0 = unlimited.
OUTBOUND_DAILY_BUDGET=300

# --- The kid's day (server-local hours) ---------------------------------------
# Weekends are never "school" regardless of these hours.
SCHOOL_START_HOUR=8
SCHOOL_END_HOUR=15
LIFE_REFRESH_HOUR=6             # when the shared daily-life state regenerates
                                 # (one LLM call/day, same story told to every chat)

# --- Stickers ------------------------------------------------------------------
# Sticker pack short name (the bit after t.me/addstickers/). Empty = no stickers.
# The pack is re-read daily, so adding stickers in Telegram makes them available
# to the kid without a redeploy. See README "Setting up stickers".
STICKER_PACK_NAME=
STICKER_RANDOM_CHANCE=0.07      # chance a burst gets an extra unprompted sticker tacked on

# --- Proactive behaviour ---------------------------------------------------------
# GHOST_ENABLED=false stops the kid ever chasing you after you go quiet.
GHOST_ENABLED=true
COLDOPEN_ENABLED=true           # texting you first, unprompted, on an eligible day
COLDOPEN_MIN_BOND=10            # bond score needed before a cold open is eligible
MAX_PINGS_PER_DAY=3             # cap on ghost-ladder pings per chat per day
